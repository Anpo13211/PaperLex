        <key>ActionBundlePath</key>
        <string>/System/Library/Automator/Run Shell Script.action</string>
        <key>ActionName</key>
        <string>Run Shell Script</string>
        <key>ActionParameters</key>
        <dict>
          <key>CheckedForUserDefaultShell</key><true/>
          <key>COMMAND_STRING</key>
          <string>helper="$HOME/Library/Application Support/PaperLex/bin/paperlex-capture"
if [[ ! -x "$helper" ]]; then
  message="PaperLex のヘルパーが見つかりません"
  capture_status=1
else
  message=$("$helper" 2&gt;&amp;1)
  capture_status=$?
fi
/usr/bin/osascript - "$message" "$capture_status" &lt;&lt;'APPLESCRIPT'
on run argv
  set noticeText to item 1 of argv
  set noticeStatus to item 2 of argv
  if noticeStatus is "0" then
    display notification noticeText with title "PaperLex"
  else
    display notification noticeText with title "PaperLex — 保存できません"
  end if
end run
APPLESCRIPT
exit $capture_status</string>
          <key>inputMethod</key><integer>0</integer>
          <key>shell</key><string>/bin/zsh</string>
          <key>source</key><string></string>
        </dict>
        <key>BundleIdentifier</key>
        <string>com.apple.RunShellScript</string>
        <key>CanShowSelectedItemsWhenRun</key><false/>
        <key>CanShowWhenRun</key><true/>
